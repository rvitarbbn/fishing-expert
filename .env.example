# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fishing_expert
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fishing_expert

# Redis (optional)
REDIS_URL=redis://localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Open-Meteo (no key required, but rate limiting applies)
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# Optional LLM providers (leave empty to disable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Admin authentication
ADMIN_SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Cache settings
FORECAST_CACHE_TTL_SECONDS=3600
RECOMMENDATION_CACHE_TTL_SECONDS=300
